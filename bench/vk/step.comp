#version 450
// replay_probe's small dependent kernel in Vulkan
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Y { float y[]; };
layout(std430, binding = 1) readonly buffer X { float x[]; };
layout(push_constant) uniform P { int n; };
void main() {
  const uint i = gl_GlobalInvocationID.x;
  if (i < uint(n)) y[i] = y[i] * 0.999 + x[i];
}
